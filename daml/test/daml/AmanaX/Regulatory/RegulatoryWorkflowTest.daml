module AmanaX.Regulatory.RegulatoryWorkflowTest where

import DA.Assert ((===))
import Daml.Script
import AmanaX.Identity.Organization (OrgRole(..))
import AmanaX.Product.Types
import AmanaX.Product.ProductProposal
import AmanaX.Product.ProductStructure
import AmanaX.Review.Review
import AmanaX.Regulatory.Regulatory

-- | Milestone 4 gate: a reviewed product can be submitted and SEC-approved
-- on-ledger. Covers Step 8-9 from docs/prompt.md end to end, continuing on
-- from an approved TrusteeReview (same setup as
-- AmanaX.Review.ReviewWorkflowTest.shariahAndTrusteeReviewTest).
regulatorySubmissionApprovalTest : Script ()
regulatorySubmissionApprovalTest = do
  fundManager <- allocateParty "FundManagerRegCo"
  issuingHouse <- allocateParty "IssuingHouseRegCo"
  shariahAdvisor <- allocateParty "ShariahAdvisorRegCo"
  trustee <- allocateParty "TrusteeRegCo"
  sec <- allocateParty "SECRegCo"

  proposalCid <- submit fundManager do
    createCmd ProductProposal with
      sponsor = fundManager
      sponsorType = FundManager
      issuingHouse
      productName = "AmanaX Sukuk Note I"
      description = "A Shariah-compliant Ijarah-backed investment note."
      proposedType = Ijarah
      targetSizeNGN = 500000000.0
      tenorMonths = 24

  structureCid <- submit issuingHouse do
    exerciseCmd proposalCid ProductProposal_Structure with
      structureType = Ijarah
      profitMechanism = "Lease rental distributed quarterly"
      minSubscriptionNGN = 1000000.0
      redemptionTerms = "Bullet redemption at maturity"
      structureTenorMonths = 24

  finalizedCid <- submit issuingHouse do
    exerciseCmd structureCid ProductStructure_Finalize

  shariahRequestCid <- submit issuingHouse do
    createCmd ShariahReviewRequest with
      issuingHouse
      shariahAdvisor
      sponsor = fundManager
      structureCid = finalizedCid
      productName = "AmanaX Sukuk Note I"
      description = "A Shariah-compliant Ijarah-backed investment note."
      structureType = Ijarah
      targetSizeNGN = 500000000.0
      tenorMonths = 24
      profitMechanism = "Lease rental distributed quarterly"
      minSubscriptionNGN = 1000000.0
      redemptionTerms = "Bullet redemption at maturity"

  shariahReviewCid <- submit shariahAdvisor do
    exerciseCmd shariahRequestCid ShariahReviewRequest_Certify with
      certificationNotes = "Structure conforms to Ijarah principles."

  trusteeRequestCid <- submit issuingHouse do
    exerciseCmd shariahReviewCid ShariahReview_SubmitForTrusteeReview with
      trustee

  trusteeReviewCid <- submit trustee do
    exerciseCmd trusteeRequestCid TrusteeReviewRequest_Approve with
      approvalNotes = "Governance and investor-protection terms are adequate."

  -- Step 8: Issuing House submits the filing pack to the SEC.
  submissionCid <- submit issuingHouse do
    createCmd RegulatorySubmission with
      issuingHouse
      sec
      sponsor = fundManager
      trustee
      structureCid = finalizedCid
      trusteeReviewCid
      productName = "AmanaX Sukuk Note I"
      description = "A Shariah-compliant Ijarah-backed investment note."
      structureType = Ijarah
      targetSizeNGN = 500000000.0
      tenorMonths = 24
      profitMechanism = "Lease rental distributed quarterly"
      minSubscriptionNGN = 1000000.0
      redemptionTerms = "Bullet redemption at maturity"
      certificationNotes = "Structure conforms to Ijarah principles."
      approvalNotes = "Governance and investor-protection terms are adequate."
      documents =
        [ FilingDocument with kind = "TermSheet", title = "Term Sheet — AmanaX Sukuk Note I", markdown = "# Term Sheet\n..."
        , FilingDocument with kind = "RegulatoryFiling", title = "Regulatory Filing — AmanaX Sukuk Note I", markdown = "# Filing\n..."
        ]

  -- sponsor and trustee can both see the pending submission as observers
  sponsorView <- queryContractId fundManager submissionCid
  case sponsorView of
    None -> error "expected sponsor to see the pending submission"
    Some _ -> pure ()
  trusteeView <- queryContractId trustee submissionCid
  case trusteeView of
    None -> error "expected trustee to see the pending submission"
    Some _ -> pure ()

  -- Step 9: SEC approves.
  approvalCid <- submit sec do
    exerciseCmd submissionCid RegulatorySubmission_Approve with
      approvalReference = "SEC/AMX/2026/0001"

  -- the submission is consumed
  submissionStillActive <- queryContractId issuingHouse submissionCid
  submissionStillActive === None

  approval <- queryContractId sec approvalCid
  case approval of
    None -> error "expected SECApproval to exist"
    Some a -> do
      a.approvalReference === "SEC/AMX/2026/0001"
      length a.documents === 2
      a.sponsor === fundManager
      a.trustee === trustee

-- | Issuing House can withdraw before SEC acts; SEC can reject instead of
-- approving.
withdrawAndRejectSubmissionTest : Script ()
withdrawAndRejectSubmissionTest = do
  issuingHouse <- allocateParty "IssuingHouseRegCo2"
  fundManager <- allocateParty "FundManagerRegCo2"
  trustee <- allocateParty "TrusteeRegCo2"
  sec <- allocateParty "SECRegCo2"

  -- structureCid/trusteeReviewCid are only used as opaque references by
  -- RegulatorySubmission (never fetched), so a script-only placeholder
  -- contract id via a throwaway Ping-like reference isn't needed here —
  -- reuse a real ProductStructure id from a minimal setup.
  proposalCid <- submit fundManager do
    createCmd ProductProposal with
      sponsor = fundManager
      sponsorType = FundManager
      issuingHouse
      productName = "Withdrawn Submission Note"
      description = "Will be withdrawn before SEC acts."
      proposedType = Murabahah
      targetSizeNGN = 100000.0
      tenorMonths = 6

  structureCid <- submit issuingHouse do
    exerciseCmd proposalCid ProductProposal_Structure with
      structureType = Murabahah
      profitMechanism = "Fixed markup"
      minSubscriptionNGN = 10000.0
      redemptionTerms = "Bullet"
      structureTenorMonths = 6

  finalizedCid <- submit issuingHouse do
    exerciseCmd structureCid ProductStructure_Finalize

  shariahRequestCid <- submit issuingHouse do
    createCmd ShariahReviewRequest with
      issuingHouse
      shariahAdvisor = trustee -- reusing a party is fine here; not exercised as shariahAdvisor elsewhere in this test
      sponsor = fundManager
      structureCid = finalizedCid
      productName = "Withdrawn Submission Note"
      description = "Will be withdrawn before SEC acts."
      structureType = Murabahah
      targetSizeNGN = 100000.0
      tenorMonths = 6
      profitMechanism = "Fixed markup"
      minSubscriptionNGN = 10000.0
      redemptionTerms = "Bullet"

  shariahReviewCid <- submit trustee do
    exerciseCmd shariahRequestCid ShariahReviewRequest_Certify with
      certificationNotes = "OK."

  trusteeRequestCid <- submit issuingHouse do
    exerciseCmd shariahReviewCid ShariahReview_SubmitForTrusteeReview with
      trustee

  trusteeReviewCid <- submit trustee do
    exerciseCmd trusteeRequestCid TrusteeReviewRequest_Approve with
      approvalNotes = "OK."

  withdrawnCid <- submit issuingHouse do
    createCmd RegulatorySubmission with
      issuingHouse
      sec
      sponsor = fundManager
      trustee
      structureCid = finalizedCid
      trusteeReviewCid
      productName = "Withdrawn Submission Note"
      description = "Will be withdrawn before SEC acts."
      structureType = Murabahah
      targetSizeNGN = 100000.0
      tenorMonths = 6
      profitMechanism = "Fixed markup"
      minSubscriptionNGN = 10000.0
      redemptionTerms = "Bullet"
      certificationNotes = "OK."
      approvalNotes = "OK."
      documents = []

  submit issuingHouse do
    exerciseCmd withdrawnCid RegulatorySubmission_Withdraw

  -- SEC cannot approve a withdrawn submission
  submitMustFail sec do
    exerciseCmd withdrawnCid RegulatorySubmission_Approve with
      approvalReference = "should fail"
