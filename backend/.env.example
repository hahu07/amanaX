# Ledger
PORT=4000
LEDGER_API_URL=http://localhost:7575
DAML_PACKAGE_NAME=amanax-main
LEDGER_USER_ID=amanax-backend
# Bearer token for a DevNet/TestNet/production participant (unset = no
# Authorization header, correct for the unauthenticated local dpm sandbox).
# Preferred: LEDGER_OIDC_REFRESH_TOKEN below — the backend refreshes its own
# access token indefinitely. LEDGER_API_TOKEN is a static fallback (has to be
# refreshed by hand when it expires) used only when no refresh token is set.
# See docs/deployment.md.
LEDGER_API_TOKEN=
LEDGER_OIDC_TOKEN_URL=
LEDGER_OIDC_CLIENT_ID=
LEDGER_OIDC_REFRESH_TOKEN=

# Auth — see docs/deployment.md before deploying anywhere but local dev.
# Unset falls back to a well-known dev-only secret; production refuses to
# boot on that fallback (backend/src/config.ts).
JWT_SECRET=
OPERATOR_EMAIL=operator@amanax.dev

# agents/ service
AGENTS_SERVICE_URL=http://localhost:4100
# Shared secret sent as X-Internal-Secret to the agents service. Unset in
# local dev (both sides skip the check); set to the same value on both
# services in any deployment reachable by more than just this backend.
AGENTS_SHARED_SECRET=

# CORS — unset reflects any Origin (local dev default). Set to the real
# frontend origin(s) in any non-local deployment.
ALLOWED_ORIGIN=
